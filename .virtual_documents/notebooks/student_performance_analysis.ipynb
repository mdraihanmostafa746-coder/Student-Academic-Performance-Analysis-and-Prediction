from sklearn.decomposition import PCA

X_train_pca_input = preprocessor.transform(X_train)
X_test_pca_input = preprocessor.transform(X_test)


pca = PCA(n_components=0.95)

X_train_pca = pca.fit_transform(X_train_pca_input)
X_test_pca = pca.transform(X_test_pca_input)

print("Original Features:", X_train_pca_input.shape[1])
print("PCA Features:", X_train_pca.shape[1])
print("Explained Variance:", pca.explained_variance_ratio_.sum())


import matplotlib.pyplot as plt
import numpy as np

cumulative_variance = np.cumsum(pca.explained_variance_ratio_)

plt.figure(figsize=(8, 5))
plt.plot(range(1, len(cumulative_variance) + 1),
         cumulative_variance, marker='o')

plt.axhline(y=0.95, color='red', linestyle='--')
plt.xlabel("Number of Principal Components")
plt.ylabel("Cumulative Explained Variance")
plt.title("PCA - Explained Variance")
plt.grid()
plt.show()


