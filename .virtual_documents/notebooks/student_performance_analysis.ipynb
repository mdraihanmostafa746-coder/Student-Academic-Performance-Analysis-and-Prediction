def categorize_performance(score):
    if score < 60:
        return 'Low'
    elif score < 80:
        return 'Medium'
    else:
        return 'High'

y_class = y.apply(categorize_performance)

print(y_class.value_counts())


from sklearn.model_selection import train_test_split

X_train_cls, X_test_cls, y_train_cls, y_test_cls = train_test_split(
    X, y_class,
    test_size=0.2,
    random_state=42,
    stratify=y_class
)


from sklearn.linear_model import LogisticRegression
from sklearn.neighbors import KNeighborsClassifier
from sklearn.pipeline import Pipeline

logistic_model = Pipeline([
    ('preprocessor', preprocessor),
    ('model', LogisticRegression(max_iter=1000))
])

knn_model = Pipeline([
    ('preprocessor', preprocessor),
    ('model', KNeighborsClassifier(n_neighbors=5))
])

logistic_model.fit(X_train_cls, y_train_cls)
knn_model.fit(X_train_cls, y_train_cls)

y_pred_logistic = logistic_model.predict(X_test_cls)
y_pred_knn = knn_model.predict(X_test_cls)


from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    classification_report,
    confusion_matrix
)

for name, predictions in [
    ('Logistic Regression', y_pred_logistic),
    ('KNN', y_pred_knn)
]:
    print(f"\n{name}")
    print("Accuracy:", accuracy_score(y_test_cls, predictions))
    print("Precision:", precision_score(
        y_test_cls, predictions, average='weighted', zero_division=0
    ))
    print("Recall:", recall_score(
        y_test_cls, predictions, average='weighted', zero_division=0
    ))
    print("F1 Score:", f1_score(
        y_test_cls, predictions, average='weighted', zero_division=0
    ))
    print(classification_report(y_test_cls, predictions, zero_division=0))


import matplotlib.pyplot as plt
import seaborn as sns

fig, axes = plt.subplots(1, 2, figsize=(12, 5))

for ax, name, predictions in [
    (axes[0], 'Logistic Regression', y_pred_logistic),
    (axes[1], 'KNN', y_pred_knn)
]:
    cm = confusion_matrix(
        y_test_cls, predictions, labels=['Low', 'Medium', 'High']
    )
    sns.heatmap(
        cm, annot=True, fmt='d', cmap='Blues',
