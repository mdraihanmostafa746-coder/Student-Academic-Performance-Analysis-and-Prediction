from mlxtend.frequent_patterns import apriori, association_rules

# Convert categorical features into transactions
association_data = df_clean.drop(columns=['Exam_Score']).copy()

# Bin numerical columns
numeric_cols = association_data.select_dtypes(include=np.number).columns

for col in numeric_cols:
    association_data[col] = pd.cut(
        association_data[col],
        bins=3,
        labels=['Low', 'Medium', 'High']
    )

# Convert values into categorical transactions
association_data = association_data.astype(str)
association_data = pd.get_dummies(association_data, dtype=bool)

# Find frequent itemsets
frequent_items = apriori(
    association_data,
    min_support=0.05,
    use_colnames=True
)

# Generate association rules
rules = association_rules(
    frequent_items,
    metric='confidence',
    min_threshold=0.5
)

rules[['antecedents', 'consequents', 'support', 'confidence', 'lift']].head(10)





